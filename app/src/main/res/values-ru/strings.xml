    <!-- AboutScreen -->
    <string name="about_title">О приложении</string>
    <string name="about_description">VoltGuard отслеживает батарею в реальном времени: уровень заряда, температуру, напряжение, состояние и количество циклов. Фоновый сервис отправляет оповещения при достижении 20% или 80%.</string>
    <string name="features">Возможности</string>
    <string name="features_desc">\u2022 Живая статистика с анимацией&#10;\u2022 Фоновый сервис с уведомлениями&#10;\u2022 Состояние и количество циклов&#10;\u2022 Пороговые оповещения (20% / 80%)&#10;\u2022 Пульсирующий индикатор при зарядке</string>
    <string name="tech_stack">Технологии</string>
    <string name="tech_stack_desc">Kotlin \u00B7 Jetpack Compose \u00B7 Material 3&#10;MVVM \u00B7 StateFlow \u00B7 Foreground Service</string>
